# Runtime
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-bot-host.example
NODE_ENV=development

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Twilio sandbox (set ACCOUNT_SID + AUTH_TOKEN to enable the "Analyzing..." + verdict
# two-message flow and inbound signature verification). API_BASE override is for tests only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE=https://api.twilio.com

# Analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ENABLE_OPENAI_ANALYSIS=false

# Privacy / data minimization
SESSION_TTL_MINUTES=30
DATA_DIR=./bot/data
USER_HASH_SALT=change-this-before-launch

# Guardrails / cost controls
PER_USER_DAILY_CHECK_LIMIT=25
GLOBAL_DAILY_CHECK_LIMIT=500
ESTIMATED_COST_CENTS_PER_CHECK=3
ESTIMATED_DAILY_COST_CENTS_LIMIT=5000
