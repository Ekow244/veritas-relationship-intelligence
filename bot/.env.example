# Runtime
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-bot-host.example
NODE_ENV=development

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Twilio sandbox fallback
TWILIO_AUTH_TOKEN=

# Analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ENABLE_OPENAI_ANALYSIS=false

# Privacy / data minimization
SESSION_TTL_MINUTES=30
DATA_DIR=./bot/data
USER_HASH_SALT=change-this-before-launch
